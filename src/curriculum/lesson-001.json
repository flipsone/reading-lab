    "literal_sentence_meaning"
  ],
  "sounds": [
    {
      "grapheme": "a",
      "phoneme": "/ă/",
      "cue": "Short a, as in apple. Keep the vowel clear and open.",
      "continuous": true
    },
    {
      "grapheme": "m",
      "phoneme": "/m/",
      "cue": "Close your lips and hum mmm. Keep the sound flowing; no added uh.",
      "continuous": true
    },
    {
      "grapheme": "n",
      "phoneme": "/n/",
      "cue": "Tongue behind the upper teeth; hold nnn gently. No added uh.",
      "continuous": true
    },
    {
      "grapheme": "s",
      "phoneme": "/s/",
      "cue": "Let air flow smoothly: sss. No added uh.",
      "continuous": true
    },
    {
      "grapheme": "f",
      "phoneme": "/f/",
      "cue": "Upper teeth gently touch the lower lip; let air flow: fff. No added uh.",
      "continuous": true
    },
    {
      "grapheme": "t",
      "phoneme": "/t/",
      "cue": "Use a brief, crisp /t/. Do not stretch it or say tuh.",
      "continuous": false
    }
  ],
